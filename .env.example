# Copy to .env and adjust. No real secrets belong in this file.

# Which kubeconfig to use when not running in-cluster. Defaults to ~/.kube/config.
KUBESENTINEL_KUBECONFIG=

# kubeconfig context to use. Empty = current-context.
KUBESENTINEL_KUBE_CONTEXT=

# Namespaces the observer watches. Comma-separated. Empty = all namespaces.
KUBESENTINEL_WATCH_NAMESPACES=kubesentinel-lab

# Namespaces remediation actions are allowed to target. Never include system namespaces.
KUBESENTINEL_ACTION_ALLOWED_NAMESPACES=kubesentinel-lab

# Optional: specific Deployment names remediation may target, comma-separated.
# Empty = no additional restriction beyond the namespace allowlist above.
KUBESENTINEL_ACTION_ALLOWED_RESOURCE_NAMES=

# OBSERVE | APPROVAL_REQUIRED | CONTROLLED_AUTO
KUBESENTINEL_POLICY_MODE=OBSERVE

# Budgets and cooldowns the policy engine enforces before any action executes.
KUBESENTINEL_MAX_ACTIONS_PER_INCIDENT=3
KUBESENTINEL_MAX_ACTIONS_PER_WINDOW=10
KUBESENTINEL_ACTION_WINDOW_SECONDS=600
KUBESENTINEL_ACTION_COOLDOWN_SECONDS=60

# SQLite file path for incident/audit persistence.
KUBESENTINEL_DB_PATH=./kubesentinel.db

# Bind address/port for the FastAPI server.
KUBESENTINEL_API_HOST=127.0.0.1
KUBESENTINEL_API_PORT=8000

# Static bearer token required for mutating API endpoints (plan/approve/execute).
# Generate your own locally, e.g. `openssl rand -hex 32`. Leave empty only for local OBSERVE-only use.
KUBESENTINEL_API_TOKEN=

# Log level: DEBUG | INFO | WARNING | ERROR
KUBESENTINEL_LOG_LEVEL=INFO

# How long the recovery verifier polls after a successful action before giving up
# and recording INCONCLUSIVE rather than waiting indefinitely.
KUBESENTINEL_VERIFICATION_DEADLINE_SECONDS=60
KUBESENTINEL_VERIFICATION_POLL_INTERVAL_SECONDS=2

# Optional AI summarization (Milestone 11). Disabled by default -- everything
# above works fully without this. The only backend is a local Ollama server:
# no API key, no cloud account, no per-request cost. Install from
# https://ollama.com, then `ollama pull qwen2.5-coder:3b` (or any model you
# have) before setting KUBESENTINEL_AI_ENABLED=true. AI never gets write
# access to the cluster or any say in policy -- see RBAC_AND_THREAT_MODEL.md.
KUBESENTINEL_AI_ENABLED=false
KUBESENTINEL_AI_BASE_URL=http://localhost:11434
KUBESENTINEL_AI_MODEL=qwen2.5-coder:3b
KUBESENTINEL_AI_TIMEOUT_SECONDS=30
